<turbo-frame id="survey_<%= survey.id %>"  class="survey-frame">
  <%= simple_form_for [survey, @survey_response] do |f| %>
    <%= f.hidden_field :survey_id, value: survey.id %>
    <div class="survey-question-section">
      <p><strong>Survey Question:</strong> <%= survey.question %></p>
    </div>
    <div class="analytics-item">
      <%# Updated to use answer_id with collection from survey.answers %>
      <%# Displays the predefined answer options for this survey %>
      <%= f.input :answer_id, 
                  as: :radio_buttons, 
                  collection: survey.answers,
                  label_method: :text,
                  value_method: :id,
                  label: 'Select your answer:' %>
    </div>
    <div class="survey-actions">
      <%= f.button :submit %>
     </div>
  <% end %>
</turbo-frame>
