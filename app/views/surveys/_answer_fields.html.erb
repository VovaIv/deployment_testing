<%# Partial for individual answer field with remove functionality %>
<div class="nested-fields mb-3">
  <div class="d-flex align-items-center gap-2">
    <%= f.input :text, 
                label: false, 
                placeholder: "Enter answer option",
                input_html: { class: 'form-control' },
                wrapper_html: { class: 'flex-grow-1' } %>
    
    <%# Hidden field for marking records for destruction %>
    <%= f.input :_destroy, as: :hidden %>
    
    <%# Remove button %>
    <%= link_to "Remove", "#", 
                class: "btn btn-danger btn-sm", 
                data: { action: "click->nested-form#remove" } %>
  </div>
</div>
