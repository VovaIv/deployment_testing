<!-- Partial for individual answer field -->
<div class="nested-fields" data-nested-form-target="item" style="margin-bottom: 10px;">
  <div class="input-group">
    <%= f.input :text, 
        label: false,
        placeholder: 'Answer text (e.g., Yes, No, Maybe)',
        input_html: { class: 'form-control' },
        wrapper: false %>
    
    <!-- Hidden field for _destroy flag -->
    <%= f.hidden_field :_destroy, value: false, data: { nested_form_target: "destroyField" } %>
    
    <!-- Remove button -->
    <button type="button" 
            class="btn btn-danger btn-sm" 
            data-action="click->nested-form#remove"
            style="margin-left: 5px;">
      Remove
    </button>
  </div>
</div>
