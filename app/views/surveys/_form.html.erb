<div class="form-container">
  <%= simple_form_for survey do |f| %>
    <!-- Survey Question Field -->
    <div class="form-group">
      <%= f.input :question, input_html: { class: 'form-control', placeholder: 'Enter your question here' }, wrapper: false %>
    </div>

    <!-- Dynamic Answer Fields Section using Hotwire/Stimulus -->
    <!-- The nested-form controller manages adding/removing answer fields dynamically -->
    <div data-controller="nested-form" class="mt-4">
      <h4>Answer Options</h4>
      <p class="text-muted">Add predefined answer options for users to select from</p>
      
      <!-- Container for existing and new answer fields -->
      <div data-nested-form-target="container">
        <%= f.simple_fields_for :answers do |answer_form| %>
          <%= render 'answer_fields', f: answer_form %>
        <% end %>
      </div>

      <!-- Template for new answer fields (hidden, cloned by Stimulus) -->
      <!-- NEW_RECORD is replaced with a unique timestamp when cloned -->
      <template data-nested-form-target="template">
        <%= f.simple_fields_for :answers, Answer.new, child_index: 'NEW_RECORD' do |answer_form| %>
          <%= render 'answer_fields', f: answer_form %>
        <% end %>
      </template>

      <!-- Button to add a new answer field -->
      <div class="mt-3">
        <button type="button" 
                class="btn btn-secondary btn-sm" 
                data-action="click->nested-form#add">
          + Add Answer Option
        </button>
      </div>
    </div>

    <!-- Form Actions -->
    <div class="form-actions mt-4">
      <%= f.button :submit, class: 'btn btn-primary' %>
      <%= link_to 'Back to Surveys', surveys_path, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>
