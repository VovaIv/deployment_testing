<div class="form-container">
  <%= form_with model: survey, html: { data: { controller: "nested-form" } } do |f| %>
    
    <%= render 'shared/error_messages', object: survey %>

    <div class="form-group">
      <%= f.text_field :question, class: 'form-control', placeholder: 'Enter your question here' %>
    </div>

    <div class="form-group">
      <label class="form-label">Answer Options</label>
      
      <!-- Template for new answer fields (hidden) -->
      <template data-nested-form-target="template">
        <%= f.fields_for :answers, Answer.new, child_index: '__INDEX__' do |answer_form| %>
          <%= render 'answer_fields', f: answer_form %>
        <% end %>
      </template>

      <!-- Target where answer fields will be inserted -->
      <div data-nested-form-target="target">
        <%= f.fields_for :answers do |answer_form| %>
          <%= render 'answer_fields', f: answer_form %>
        <% end %>
      </div>

      <!-- Button to add more answer fields -->
      <button type="button" 
              class="btn btn-secondary btn-sm mt-2" 
              data-action="click->nested-form#add">
        + Add Answer Option
      </button>
    </div>

    <div class="form-actions">
      <%= f.submit class: 'btn btn-primary' %>
      <%= link_to 'Back to Surveys', surveys_path, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>
