<div class="form-container">
  <%= simple_form_for survey, html: { data: { controller: "nested-form" } } do |f| %>
    <div class="form-group">
      <%= f.input :question, input_html: { class: 'form-control', placeholder: 'Enter your question here' }, wrapper: false %>
    </div>

    <%# Nested answer fields section with Hotwire dynamic management %>
    <div class="answers-section">
      <h3>Answer Options</h3>
      <p class="text-muted">Add multiple answer choices for your survey question.</p>
      
      <%# Container for all answer fields %>
      <div data-nested-form-target="container">
        <%= f.simple_fields_for :answers do |answer_form| %>
          <%= render "answer_fields", f: answer_form %>
        <% end %>
      </div>

      <%# Template for new answer fields (hidden) %>
      <template data-nested-form-target="template">
        <%= f.simple_fields_for :answers, Answer.new, child_index: "NEW_RECORD" do |answer_form| %>
          <%= render "answer_fields", f: answer_form %>
        <% end %>
      </template>

      <%# Button to add more answer fields %>
      <div class="mt-3">
        <%= link_to "Add Answer Option", "#", class: "btn btn-secondary btn-sm", data: { action: "click->nested-form#add" } %>
      </div>
    </div>

    <div class="form-actions">
      <%= f.button :submit, class: 'btn btn-primary' %>
      <%= link_to 'Back to Surveys', surveys_path, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>
