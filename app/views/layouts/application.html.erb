<!DOCTYPE html>
<html>
  <head>
    <title>SimpleSurveyTool</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header style="background-color: #f8f9fa; padding: 1rem; margin-bottom: 1rem; border-bottom: 1px solid #dee2e6;">
      <div style="display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto;">
        <div>
          <%= link_to "Survey App", root_path, style: "text-decoration: none; color: #333; font-weight: bold; font-size: 1.2rem;" %>
        </div>
        <div>
          <% if user_signed_in? %>
            <span style="margin-right: 1rem;">
              <%= current_user.email %> 
              <% if current_user.admin? %>
                <span style="background-color: #007bff; color: white; padding: 0.2rem 0.5rem; border-radius: 3px; font-size: 0.8rem; margin-left: 0.5rem;">Admin</span>
              <% end %>
            </span>
            <%= button_to "Sign Out", destroy_user_session_path, method: :delete, style: "display: inline; background-color: #dc3545; color: white; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer;" %>
          <% else %>
            <%= link_to "Sign In", new_user_session_path, style: "margin-right: 1rem; text-decoration: none; color: #007bff;" %>
            <%= link_to "Sign Up", new_user_registration_path, style: "text-decoration: none; color: #007bff;" %>
          <% end %>
        </div>
      </div>
    </header>

    <% if notice %>
      <p class="notice" style="background-color: #d4edda; color: #155724; padding: 0.75rem 1.25rem; margin: 1rem; border-radius: 4px;"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="alert" style="background-color: #f8d7da; color: #721c24; padding: 0.75rem 1.25rem; margin: 1rem; border-radius: 4px;"><%= alert %></p>
    <% end %>

    <%= yield %>
  </body>
</html>
