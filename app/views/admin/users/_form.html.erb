<%= render 'shared/error_messages', object: user %>

<%= form_with model: [:admin, user] do |f| %>
  <div class="form-group" style="margin-bottom: 1rem;">
    <%= f.label :email, style: 'display: block; margin-bottom: 0.5rem; font-weight: bold;' %>
    <%= f.email_field :email, class: 'form-control', style: 'width: 100%; padding: 0.5rem; border: 1px solid #ced4da; border-radius: 4px;' %>
  </div>

  <div class="form-group" style="margin-bottom: 1rem;">
    <%= f.label :role, style: 'display: block; margin-bottom: 0.5rem; font-weight: bold;' %>
    <% if user == current_user %>
      <p style="color: #6c757d; font-size: 0.9rem; margin: 0;">Your own role cannot be changed.</p>
    <% else %>
      <%= f.select :role, [['User', 'user'], ['Admin', 'admin']], {}, class: 'form-control', style: 'width: 100%; padding: 0.5rem; border: 1px solid #ced4da; border-radius: 4px;' %>
    <% end %>
  </div>

  <% if user.persisted? %>
  <div class="form-group" style="margin-bottom: 1rem;">
    <%= f.label :password, style: 'display: block; margin-bottom: 0.5rem; font-weight: bold;' %>
    <small style="color: #6c757d; display: block; margin-bottom: 0.25rem;">Leave blank to keep current password</small>
    <%= f.password_field :password, class: 'form-control', autocomplete: 'new-password', style: 'width: 100%; padding: 0.5rem; border: 1px solid #ced4da; border-radius: 4px;' %>
  </div>

  <div class="form-group" style="margin-bottom: 1.5rem;">
    <%= f.label :password_confirmation, style: 'display: block; margin-bottom: 0.5rem; font-weight: bold;' %>
    <%= f.password_field :password_confirmation, class: 'form-control', autocomplete: 'new-password', style: 'width: 100%; padding: 0.5rem; border: 1px solid #ced4da; border-radius: 4px;' %>
  </div>
  <% else %>
  <p style="color: #6c757d; font-size: 0.9rem; margin-bottom: 1.5rem;">A password setup email will be sent to the user.</p>
  <% end %>

  <div class="form-actions">
    <%= f.submit class: 'btn btn-primary', style: 'margin-right: 0.5rem;' %>
    <%= link_to 'Back to Users', admin_users_path, class: 'btn btn-secondary' %>
  </div>
<% end %>
